# Use the address of the machine running Handy, as seen from the Hermes container.
# Both http://192.168.1.50:8756 and http://192.168.1.50:8756/v1 are accepted.
HANDY_STT_BASE_URL=http://192.168.1.50:8756

# Copy the server token shown by Handy. Do not commit the populated env file.
HANDY_STT_TOKEN=replace-me
